# Use LF for text files on every platform.
* text=auto eol=lf

# Preserve Windows batch script line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.class binary
*.woff2 binary
