# Local settings. Copy to ignored .env; use a trusted LAN only for classroom access.
# Keep loopback defaults for development on one computer. Set HOST=0.0.0.0 and
# CLIENT_ORIGIN=http://<teacher-LAN-address>:5173, VITE_HOST=0.0.0.0, and
# VITE_API_BASE_URL=http://<teacher-LAN-address>:3000 when student devices connect.
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://127.0.0.1:5173
VITE_HOST=127.0.0.1
VITE_API_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/quiz-buzzer.sqlite

# Required teacher login credentials. Set real values only in ignored .env.
TEACHER_USERNAME=
TEACHER_PASSWORD=

# Configure these only in your ignored local .env when enabling Guided Notes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
